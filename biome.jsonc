{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"maxSize": 10485760,
		"includes": [
			"**",
			"!dist",
			"!**/src/crimson-desert-save-editor/lib/generated/*.json",
			"!**/src/spooners/data/*.json"
		]
	},
	"linter": {
		"rules": {
			"complexity": {
				"noImportantStyles": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["public/icons/**"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
				}
			}
		}
	]
}
