{
	"name": "chneau.github.io",
	"type": "module",
	"scripts": {
		"start": "rsbuild dev",
		"start:birthday": "rsbuild dev --environment birthday",
		"start:scotland-rail": "rsbuild dev --environment scotland-rail",
		"start:crimson-desert-save-editor": "rsbuild dev --environment crimson-desert-save-editor",
		"build": "bun run src/birthday/_genIcs.ts && rsbuild build && cp README.md dist/",
		"build:birthday": "bun run src/birthday/_genIcs.ts && rsbuild build --environment birthday",
		"build:scotland-rail": "rsbuild build --environment scotland-rail",
		"build:crimson-desert-save-editor": "rsbuild build --environment crimson-desert-save-editor",
		"build:all": "bun run build",
		"test:crimson-desert-save-editor": "bun test src/crimson-desert-save-editor",
		"deploy": "bun run build && gh-pages --dist dist --branch master; rm -rf dist",
		"deploy:all": "bun run deploy",
		"upgrade": "bun update --latest",
		"check": "bun run --sequential --no-exit-on-error check:clean check:deno check:oxlint check:biome check:export lint",
		"lint": "tsc --noEmit",
		"all": "bun run --sequential --no-exit-on-error upgrade check",
		"check:deno": "deno fmt --use-tabs --quiet",
		"check:oxlint": "oxlint --fix-dangerously --fix-suggestions --fix --quiet",
		"check:biome": "timeout 3s biome check --write --unsafe .",
		"check:clean": "rm -rf dist out build",
		"check:export": "ts-unused-exports tsconfig.json --ignoreFiles=rsbuild.config.ts"
	},
	"dependencies": {
		"@ant-design/charts": "^2.6.7",
		"@ant-design/icons": "^6.3.4",
		"@mantine/core": "9.6.2",
		"@mantine/hooks": "9.6.2",
		"@tanstack/react-query": "^5.103.2",
		"antd": "^6.6.5",
		"canvas-confetti": "^1.9.4",
		"dayjs": "^1.11.23",
		"es-toolkit": "^1.52.0",
		"fuse.js": "^7.5.0",
		"html2canvas": "^1.4.1",
		"i18next": "^26.4.2",
		"i18next-browser-languagedetector": "^8.2.1",
		"lucide-react": "1.47.0",
		"posthog-js": "^1.434.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-i18next": "^17.0.15",
		"valtio": "^2.3.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@rsbuild/core": "^2.2.8",
		"@rsbuild/plugin-react": "^2.1.0",
		"@types/bun": "^1.4.2",
		"@types/canvas-confetti": "^1.9.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"gh-pages": "^6.3.0",
		"typescript": "^7.0.2"
	}
}
