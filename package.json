{
	"name": "chneau.github.io",
	"type": "module",
	"scripts": {
		"start": "rsbuild dev",
		"start:cv": "rsbuild dev --environment cv",
		"start:birthday": "rsbuild dev --environment birthday",
		"start:scotland-rail": "rsbuild dev --environment scotland-rail",
		"start:crimson-desert-save-editor": "rsbuild dev --environment crimson-desert-save-editor",
		"start:spooners": "rsbuild dev --environment spooners",
		"start:design": "rsbuild dev --environment design",
		"clean": "rm -rf dist out build",
		"build": "bun run clean && bun run src/birthday/_genIcs.ts && rsbuild build && cp README.md dist/",
		"build:cv": "bun run clean && rsbuild build --environment cv",
		"build:birthday": "bun run clean && bun run src/birthday/_genIcs.ts && rsbuild build --environment birthday",
		"build:scotland-rail": "bun run clean && rsbuild build --environment scotland-rail",
		"build:crimson-desert-save-editor": "bun run clean && rsbuild build --environment crimson-desert-save-editor",
		"build:spooners": "bun run clean && rsbuild build --environment spooners",
		"build:design": "bun run clean && rsbuild build --environment design",
		"build:all": "bun run build",
		"test": "bun test",
		"test:crimson-desert-save-editor": "bun test src/crimson-desert-save-editor",
		"deploy": "published=; trap '[ -n \"$published\" ] && rm -rf dist' EXIT; bun run build && gh-pages --dist dist --branch master && published=1",
		"deploy:all": "bun run deploy",
		"upgrade": "bun update --latest",
		"check": "bun run --sequential check:clean check:deno check:oxlint check:biome check:export lint test",
		"check:fix": "bun run --sequential --no-exit-on-error check:deno check:oxlint check:biome",
		"lint": "tsc --noEmit",
		"all": "bun run --sequential --no-exit-on-error upgrade check",
		"check:deno": "deno fmt --use-tabs --quiet",
		"check:oxlint": "oxlint --fix-dangerously --fix-suggestions --fix --quiet",
		"check:biome": "timeout 3s biome check --write --unsafe .",
		"check:clean": "bun run clean",
		"check:export": "ts-unused-exports tsconfig.json --ignoreFiles=rsbuild.config.ts"
	},
	"dependencies": {
		"@mantine/charts": "9.6.2",
		"@mantine/core": "9.6.2",
		"@mantine/dates": "9.6.2",
		"@mantine/hooks": "9.6.2",
		"@mantine/notifications": "9.6.2",
		"@tanstack/react-query": "^5.103.2",
		"canvas-confetti": "^1.9.4",
		"dayjs": "^1.11.23",
		"es-toolkit": "^1.52.0",
		"fuse.js": "^7.5.0",
		"html2canvas": "^1.4.1",
		"i18next": "^26.4.2",
		"i18next-browser-languagedetector": "^8.2.1",
		"leaflet": "^1.9.4",
		"lucide-react": "1.47.0",
		"posthog-js": "^1.434.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-i18next": "^17.0.15",
		"react-leaflet": "^5.0.0",
		"recharts": "^3.10.1",
		"valtio": "^2.3.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@happy-dom/global-registrator": "^20.14.5",
		"@rsbuild/core": "^2.2.8",
		"@rsbuild/plugin-react": "^2.1.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "^1.4.2",
		"@types/canvas-confetti": "^1.9.0",
		"@types/leaflet": "^1.9.22",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.13.0",
		"deno": "2.9.6",
		"gh-pages": "^6.3.0",
		"oxlint": "1.85.0",
		"typescript": "^7.0.2"
	}
}
